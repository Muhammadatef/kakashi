{
  "name": "@muhammadatef/kakashi",
  "version": "1.3.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Sovereign privacy layer for agentic AI. Detects Emirates ID, UAE IBAN, Arabic names, plus 30+ credential and PII patterns. Client-side DB masking (Postgres, MySQL, MongoDB, Snowflake, Databricks, SQLite). Bilingual EN/AR. Works in Claude Code, Cursor, Copilot, Codex, and 20+ agents. 50+ file formats. Zero network calls.",
  "author": "Mohamed Atef Fahmy <muhamedfahmy7474@gmail.com> (https://github.com/Muhammadatef)",
  "license": "MIT",
  "homepage": "https://github.com/Muhammadatef/kakashi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammadatef/kakashi.git"
  },
  "bugs": {
    "url": "https://github.com/Muhammadatef/kakashi/issues"
  },
  "bin": {
    "kakashi": "bin/kakashi.js",
    "k": "bin/kakashi.js"
  },
  "scripts": {
    "install-agents": "node bin/install.js",
    "test": "node tests/run.js",
    "docs:pdf": "chromium --headless --disable-gpu --no-sandbox --no-pdf-header-footer --print-to-pdf=docs/TECHNICAL_IMPLEMENTATION.pdf --virtual-time-budget=5000 --run-all-compositor-stages-before-draw \"file://$PWD/docs/TECHNICAL_IMPLEMENTATION.html\"",
    "docs:metrics": "node scripts/build-metric-evidence.js"
  },
  "dependencies": {
    "xlsx": "^0.18.5",
    "jszip": "^3.10.1",
    "pdf-parse": "^1.1.1",
    "commander": "^11.0.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "glob": "^10.3.10"
  },
  "optionalDependencies": {
    "pg": "^8.11.0",
    "mysql2": "^3.6.0",
    "mongodb": "^6.3.0",
    "snowflake-sdk": "^1.9.0",
    "@databricks/sql": "^1.7.0",
    "better-sqlite3": "^11.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "privacy",
    "data-masking",
    "secrets",
